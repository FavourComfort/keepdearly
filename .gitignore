# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Vercel Build Output — a machine-specific build artifact. Committing it makes
# Vercel deploy this prebuilt folder directly and SKIP `vite build`, so the
# site ends up running a stale (often cross-OS) bundle instead of a fresh one.
.vercel

# Local environment files — never commit real credentials.
# `.env.example` stays tracked so the expected variable names are documented.
.env
.env.*
!.env.example

# Production CLIENT config is tracked on purpose: every value in
# `.env.production` is inlined into the public browser bundle by Vite anyway,
# so committing it leaks nothing and keeps `vite build` self-contained.
# `.env.local` stays ignored — it holds the server-only secrets.
!.env.production

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local verification scratch for the Web Push crypto (Phase 4B).
# Kept on disk so `node .verify-webpush.ts` can be re-run, never committed.
.verify-webpush.ts
.debug-rfc.ts
.verify-out.txt
