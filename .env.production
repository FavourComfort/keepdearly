# KeepDearly — production client configuration (COMMITTED ON PURPOSE)
#
# Why this file is tracked:
#   Vite statically replaces `import.meta.env.VITE_*` with string literals at
#   build time, so every value below is already delivered to every visitor's
#   browser inside the JavaScript bundle. Committing them exposes nothing new,
#   and it makes production builds deterministic instead of depending on a
#   dashboard variable being present in the right scope.
#
# NEVER add a secret here — no Supabase service_role / sb_secret_ key, no VAPID
# private key, no CRON_SECRET, no SMTP password. Anything reaching a VITE_-
# prefixed variable is public by definition. Server-only secrets belong in the
# host's runtime environment (Vercel → Project → Settings → Environment
# Variables), never in git, and never under a VITE_ prefix.
#
# Local development: `.env.local` is git-ignored and loaded in every mode, so it
# keeps holding the two server secrets that `npm run dev` needs. A fresh clone
# can copy this file to `.env.local` to run the app locally.

# Public URL of the Supabase project.
VITE_SUPABASE_URL=https://xnvfqxnaonitfricqzum.supabase.co

# Publishable (a.k.a. anon) API key. It is public by design and only safe
# because of the Row Level Security policies in supabase/migrations.
VITE_SUPABASE_ANON_KEY=sb_publishable_ibtM6InE9PBlb-Wr9geJxw_ACebjjDQ

# Web Push application-server public key (the private half stays server-side).
VITE_VAPID_PUBLIC_KEY=BErMl5ZW3qvDsOawMgLe0epUYf4RcsIktLyBVXav33BGjc2uvl2cKp9dRRlm-i2tc5Pxgyc-sp93niWP-wx4flA
