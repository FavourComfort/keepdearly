# KeepDearly — local environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings -> API).
#
#   cp .env.example .env.local     (macOS / Linux)
#   copy .env.example .env.local   (Windows)
#
# `.env.local` is git-ignored and must never be committed.
#
# `.env.production` IS committed on purpose: it holds only the three public
# client values (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_VAPID_PUBLIC_KEY),
# which Vite inlines into the browser bundle anyway. The server-side variables at
# the bottom of this file must never be added to it.
#
# The VITE_SUPABASE_ANON_KEY is the PUBLIC anon key. It is designed to be
# visible in the browser and is only made safe by the Row Level Security
# policies in supabase/migrations. Never use the service_role key here —
# it bypasses RLS and must never reach the client bundle.

# Public URL of your Supabase project, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Public anon / publishable key for your Supabase project
VITE_SUPABASE_ANON_KEY=

# VAPID public key used only for Web Push subscription (browser-safe).
# This is the PUBLIC half of the VAPID keypair and may be bundled in client code.
# The PRIVATE half (VAPID_PRIVATE_KEY) must never be committed or bundled.
# Keep it in .env.local only, and move it to server-side secrets when sending is implemented.
# If this value is empty, push subscription stays disabled and the app must fail gracefully.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-side reminder delivery (Phase 4B) — SERVER ONLY.
#
# The variables below are read from `process.env` by server code and never bundled.
# NEVER prefix them with VITE_ (VITE_ values are inlined into client code).
# Generate a CRON_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# Bearer token the scheduler must present to /api/reminders/due.
# The scheduler sends it as `Authorization: Bearer <CRON_SECRET>` on every
# invocation, so this value MUST match the secret configured in that scheduler.
# The endpoint answers GET (the scheduled method) and POST (manual testing)
# with the same check. Use at least 16 random characters.
CRON_SECRET=

# Supabase service_role key (Project Settings -> API). Server-side only: it
# bypasses RLS so the delivery pass can read every user's due reminders.
SUPABASE_SERVICE_ROLE_KEY=

# PRIVATE half of the VAPID keypair (base64url, 32-byte P-256 scalar).
# Pairs with VITE_VAPID_PUBLIC_KEY; used to sign the VAPID JWT (RFC 8292).
VAPID_PRIVATE_KEY=

# Optional contact URI for the VAPID JWT (must be https: or mailto:, RFC 8292).
# When unset, delivery uses the request origin, then the Supabase project URL.
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Scheduled-message email delivery (Phase 6C) — SERVER ONLY.
#
# These are read from `process.env` by src/lib/email.server.ts and are never
# bundled into the browser. NEVER give them a VITE_ prefix.
#
# Sending requires a DOMAIN VERIFIED IN RESEND. Resend will not send from a
# shared domain; until your domain is verified, sending fails with
# "rejected" and messages land in the `failed` state.
# ---------------------------------------------------------------------------

# Resend API key (Resend dashboard -> API Keys). Server-side only.
RESEND_API_KEY=

# The verified From address, e.g. "KeepDearly <hello@yourdomain.com>".
# It must be an address on a domain you have verified in Resend. This is
# configuration rather than code so the same build works in staging and prod.
RESEND_FROM=

# ---------------------------------------------------------------------------
# Plus payments via Nylon Pay (Phase 6D) — SERVER ONLY.
#
# KeepDearly Plus is a ONE-TIME purchase of UGX 2,000, collected in Uganda by
# Mobile Money (MTN MoMo / Airtel Money). There is no subscription and no
# recurring billing. The price is a server constant and is also CHECK-constrained
# in the database, so it is deliberately NOT configurable here.
#
# These are read from `process.env` by src/lib/plus.server.ts and are never
# bundled. NEVER give them a VITE_ prefix, and never add them to .env.production.
#
# SANDBOX FIRST. Nylon Pay decides test vs live from the KEY ITSELF:
#   - a key beginning npk_test_ runs against sandbox providers, moves no real
#     money, and is the correct choice for development and for the initial
#     end-to-end test;
#   - a key beginning npk_live_ processes real money.
# There is no separate environment flag, so the two can never disagree.
# Do not swap in live credentials until the sandbox flow has been verified.
# ---------------------------------------------------------------------------

# Nylon Pay API key (Dashboard -> API Keys). Use an npk_test_ key to begin with.
NYLONPAY_API_KEY=

# Nylon Pay API secret (nps_...). Server-side only, never logged, never sent to
# the browser. Required to sign requests and to verify webhook signatures.
NYLONPAY_API_SECRET=

# The webhook signing secret for this API key (Dashboard -> API Settings ->
# Webhook Configuration -> Generate). Every delivery to /api/plus/webhook is
# signed with it, and a delivery that does not verify is rejected outright.
# Set this to a DIFFERENT secret than NYLONPAY_API_SECRET.
NYLONPAY_WEBHOOK_SECRET=

# Sandbox-only test aid. A sandbox (npk_test_) key never sends a real prompt to
# the payer's phone, so the collection is forced to a terminal result instead.
# "success" (the default when unset) completes the purchase; "fail" walks the
# failure screen. Deliberately ignored when NYLONPAY_API_KEY is a live key, so a
# real charge always follows the payer's own approval on their phone.
NYLONPAY_TEST_OUTCOME=
